# Practical 13 Environment Configuration (Backend only - never expose to frontend)
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/awdf_tasks_practical13
FRONTEND_URL=http://localhost:5173

# AI Provider Configuration: 'gemini' (default) or 'openai'
AI_PROVIDER=gemini

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Alternative: https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Rate Limiter: Maximum AI generation requests per minute per IP
AI_RATE_LIMIT_PER_MINUTE=5
